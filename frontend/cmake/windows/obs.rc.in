IDI_ICON1 ICON DISCARDABLE "cmake/windows/obs-studio.ico"

1 VERSIONINFO
FILEVERSION ${HIMOTHEE_VERSION_MAJOR},${HIMOTHEE_VERSION_MINOR},${HIMOTHEE_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Himothee"
      VALUE "FileDescription", "Himothee Studio"
      VALUE "FileVersion", "${HIMOTHEE_VERSION}"
      VALUE "InternalName", "HimotheeStudio"
      VALUE "OriginalFilename", "obs64.exe"
      VALUE "ProductName", "Himothee Studio"
      VALUE "ProductVersion", "${HIMOTHEE_VERSION} (OBS ${OBS_VERSION_CANONICAL})"
      VALUE "Comments", "Streaming and production software based on OBS Studio"
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
